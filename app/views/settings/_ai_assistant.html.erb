<div class="box tabular settings">
  <fieldset>
    <legend><%= l(:'ai_assistant.legend_key') %></legend>

    <p>
      <label><%= l(:'ai_assistant.setting_api_key') %></label>
      <%#
        POZOR: hodnota sa tu NIKDY nesmie vypisovať.
        `password_field_tag 'x', settings['api_key']` by vykreslil
        <input type="password" value="SKUTOCNY_KLUC"> — type="password" maskuje
        kľúč len vizuálne, v HTML je celý a vidno ho cez Inspect element.
        Preto je pole vždy prázdne; prázdne pole existujúci kľúč nezmaže
        (dopĺňa ho RedmineAiAssistant::KeyStore pri ukladaní).
      %>
      <%= password_field_tag 'settings[api_key]', nil,
            :size => 50, :autocomplete => 'off', :id => 'ai_assistant_api_key' %>
      <em class="info">
        <% if RedmineAiAssistant::KeyStore.present? %>
          <strong><%= l(:'ai_assistant.key_set',
                        :hint => RedmineAiAssistant::KeyStore.hint) %></strong><br />
        <% else %>
          <strong><%= l(:'ai_assistant.key_missing') %></strong><br />
        <% end %>
        <%= l(:'ai_assistant.setting_api_key_info') %>
      </em>
    </p>

    <% if RedmineAiAssistant::KeyStore.present? %>
      <p>
        <label><%= l(:'ai_assistant.setting_api_key_clear') %></label>
        <%= check_box_tag 'settings[api_key_clear]', '1', false %>
        <em class="info"><%= l(:'ai_assistant.setting_api_key_clear_info') %></em>
      </p>
    <% end %>
  </fieldset>

  <fieldset>
    <legend><%= l(:'ai_assistant.legend_general') %></legend>

    <p>
      <label><%= l(:'ai_assistant.setting_enabled') %></label>
      <%= hidden_field_tag 'settings[enabled]', '0' %>
      <%= check_box_tag 'settings[enabled]', '1', settings['enabled'].to_s == '1' %>
      <em class="info"><%= l(:'ai_assistant.setting_enabled_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_model') %></label>
      <%= text_field_tag 'settings[model]', settings['model'], :size => 40 %>
      <em class="info"><%= l(:'ai_assistant.setting_model_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_max_tokens') %></label>
      <%= text_field_tag 'settings[max_tokens]', settings['max_tokens'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_max_tokens_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_rate_limit') %></label>
      <%= text_field_tag 'settings[rate_limit_per_hour]', settings['rate_limit_per_hour'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_rate_limit_info') %></em>
    </p>
  </fieldset>

  <fieldset>
    <legend><%= l(:'ai_assistant.legend_reply') %></legend>

    <p class="ai-assistant-hint"><%= l(:'ai_assistant.reply_note') %></p>

    <p>
      <label><%= l(:'ai_assistant.setting_description_limit') %></label>
      <%= text_field_tag 'settings[description_limit]', settings['description_limit'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_description_limit_info') %></em>
    </p>

    <%#
      DOČASNE VYPNUTÉ: čítanie merge requestov je v backlogu, takže toto
      nastavenie zatiaľ nemá čo ladiť. Commity sa do kontextu stále pridávajú —
      platí default z RedmineAiAssistant::DEFAULTS ('changeset_limit' => '5').
      Keďže pole nie je vo formulári, pri uložení sa nezapíše a hodnota sa berie
      z defaultu. Znovu zapnutie = zmazať `if false`.

      Pozn.: `<%# … %>` sa tu použiť nedá — ERB komentár končí pri prvom `%>`,
      takže vnútorné tagy by z komentára vypadli a pole by sa renderovalo ďalej.
    %>
    <% if false %>
      <p>
        <label><%= l(:'ai_assistant.setting_changeset_limit') %></label>
        <%= text_field_tag 'settings[changeset_limit]', settings['changeset_limit'], :size => 8 %>
        <em class="info"><%= l(:'ai_assistant.setting_changeset_limit_info') %></em>
      </p>
    <% end %>

    <p>
      <label><%= l(:'ai_assistant.setting_system_prompt') %></label>
      <%= text_area_tag 'settings[system_prompt]', settings['system_prompt'],
            :rows => 14, :style => 'width:44em;' %>
      <em class="info"><%= l(:'ai_assistant.setting_system_prompt_info') %></em>
    </p>
  </fieldset>

  <fieldset>
    <legend><%= l(:'ai_assistant.legend_summary') %></legend>

    <p class="ai-assistant-hint"><%= l(:'ai_assistant.summary_note') %></p>

    <p>
      <label><%= l(:'ai_assistant.setting_summary_description_limit') %></label>
      <%= text_field_tag 'settings[summary_description_limit]',
            settings['summary_description_limit'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_summary_description_limit_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_summary_system_prompt') %></label>
      <%= text_area_tag 'settings[summary_system_prompt]', settings['summary_system_prompt'],
            :rows => 16, :style => 'width:44em;' %>
      <em class="info"><%= l(:'ai_assistant.setting_summary_system_prompt_info') %></em>
    </p>
  </fieldset>

  <fieldset>
    <legend><%= l(:'ai_assistant.legend_draft') %></legend>

    <p class="ai-assistant-hint"><%= l(:'ai_assistant.draft_note') %></p>

    <p>
      <label><%= l(:'ai_assistant.setting_draft_enabled') %></label>
      <%= hidden_field_tag 'settings[draft_enabled]', '0' %>
      <%= check_box_tag 'settings[draft_enabled]', '1', settings['draft_enabled'].to_s == '1' %>
      <em class="info"><%= l(:'ai_assistant.setting_draft_enabled_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_draft_similar_limit') %></label>
      <%= text_field_tag 'settings[draft_similar_limit]',
            settings['draft_similar_limit'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_draft_similar_limit_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_draft_translate_keywords') %></label>
      <%= hidden_field_tag 'settings[draft_translate_keywords]', '0' %>
      <%= check_box_tag 'settings[draft_translate_keywords]', '1',
            settings['draft_translate_keywords'].to_s == '1' %>
      <em class="info"><%= l(:'ai_assistant.setting_draft_translate_keywords_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_draft_max_tokens') %></label>
      <%= text_field_tag 'settings[draft_max_tokens]',
            settings['draft_max_tokens'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_draft_max_tokens_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_draft_system_prompt') %></label>
      <%= text_area_tag 'settings[draft_system_prompt]', settings['draft_system_prompt'],
            :rows => 18, :style => 'width:44em;' %>
      <em class="info"><%= l(:'ai_assistant.setting_draft_system_prompt_info') %></em>
    </p>
  </fieldset>

  <fieldset>
    <legend><%= l(:'ai_assistant.legend_plan') %></legend>

    <p class="ai-assistant-hint"><%= l(:'ai_assistant.plan_note') %></p>

    <p>
      <label><%= l(:'ai_assistant.setting_plan_enabled') %></label>
      <%= hidden_field_tag 'settings[plan_enabled]', '0' %>
      <%= check_box_tag 'settings[plan_enabled]', '1', settings['plan_enabled'].to_s == '1' %>
      <em class="info"><%= l(:'ai_assistant.setting_plan_enabled_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_plan_max_items') %></label>
      <%= text_field_tag 'settings[plan_max_items]', settings['plan_max_items'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_plan_max_items_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_plan_max_tokens') %></label>
      <%= text_field_tag 'settings[plan_max_tokens]', settings['plan_max_tokens'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_plan_max_tokens_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_plan_system_prompt') %></label>
      <%= text_area_tag 'settings[plan_system_prompt]', settings['plan_system_prompt'],
            :rows => 18, :style => 'width:44em;' %>
      <em class="info"><%= l(:'ai_assistant.setting_plan_system_prompt_info') %></em>
    </p>
  </fieldset>

  <fieldset>
    <legend><%= l(:'ai_assistant.legend_code') %></legend>

    <p>
      <label><%= l(:'ai_assistant.setting_code_enabled') %></label>
      <%= hidden_field_tag 'settings[code_context_enabled]', '0' %>
      <%= check_box_tag 'settings[code_context_enabled]', '1',
            settings['code_context_enabled'].to_s == '1' %>
      <em class="info"><%= l(:'ai_assistant.setting_code_enabled_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_gitlab_url') %></label>
      <%= text_field_tag 'settings[gitlab_url]', settings['gitlab_url'], :size => 50 %>
      <em class="info"><%= l(:'ai_assistant.setting_gitlab_url_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_gitlab_token') %></label>
      <%# Rovnaky dovod ako pri Gemini kluci: pole je VZDY prazdne, token sa do
          prehliadaca neposiela nikdy. Prazdne pole ulozeny token nezmaze. %>
      <%= password_field_tag 'settings[gitlab_token]', nil,
            :size => 50, :autocomplete => 'off', :id => 'ai_assistant_gitlab_token' %>
      <em class="info">
        <% if RedmineAiAssistant::KeyStore.present?(RedmineAiAssistant::KeyStore::GITLAB_KEY) %>
          <strong><%= l(:'ai_assistant.key_set',
                        :hint => RedmineAiAssistant::KeyStore.hint(RedmineAiAssistant::KeyStore::GITLAB_KEY)) %></strong><br />
        <% else %>
          <strong><%= l(:'ai_assistant.key_missing') %></strong><br />
        <% end %>
        <%= l(:'ai_assistant.setting_gitlab_token_info') %>
      </em>
    </p>

    <% if RedmineAiAssistant::KeyStore.present?(RedmineAiAssistant::KeyStore::GITLAB_KEY) %>
      <p>
        <label><%= l(:'ai_assistant.setting_gitlab_token_clear') %></label>
        <%= check_box_tag 'settings[gitlab_token_clear]', '1', false %>
        <em class="info"><%= l(:'ai_assistant.setting_api_key_clear_info') %></em>
      </p>
    <% end %>

    <p>
      <label><%= l(:'ai_assistant.setting_code_diff_limit') %></label>
      <%= text_field_tag 'settings[code_diff_limit]', settings['code_diff_limit'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_code_diff_limit_info') %></em>
    </p>

    <p>
      <label><%= l(:'ai_assistant.setting_code_search') %></label>
      <%= text_field_tag 'settings[code_search_results]', settings['code_search_results'], :size => 8 %>
      <em class="info"><%= l(:'ai_assistant.setting_code_search_info') %></em>
    </p>
  </fieldset>

</div>
